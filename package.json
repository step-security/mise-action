{
  "name": "@step-security/mise-action",
  "description": "mise tool setup action",
  "version": "5.3.0",
  "author": "step-security",
  "publisher": "step-security",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/step-security/mise-action.git"
  },
  "keywords": [
    "actions",
    "mise",
    "setup"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "all": "npm run format:write && npm run lint && npm run test && npm run package",
    "test": "node --test scripts/*.test.mjs",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit",
    "bundle": "npm run format:write && npm run package",
    "format:check": "oxfmt --check \"**/*.ts\"",
    "format:write": "oxfmt \"**/*.ts\"",
    "lint": "eslint . && npm run format:check",
    "package": "rimraf ./dist && rollup --config rollup.config.mjs",
    "package:watch": "npm run package -- --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/cache": "^6.0.0",
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0",
    "@actions/glob": "^0.7.0",
    "@actions/io": "^3.0.0",
    "axios": "^1.20.0",
    "handlebars": "^4.7.8",
    "packslip": "1.11.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^26.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "js-yaml": "^5.0.0",
    "oxfmt": "0.77.0",
    "rimraf": "^6.0.0",
    "rollup": "^4.0.0",
    "rollup-plugin-license": "^3.7.1",
    "supports-color": "^7.2.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.63.0"
  },
  "homepage": "https://github.com/step-security/mise-action#readme",
  "bugs": {
    "url": "https://github.com/step-security/mise-action/issues"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  }
}
